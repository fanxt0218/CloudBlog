<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudblog.content.mapper.BrowseMapper">

    <select id="calculateBrowseCount" resultType="java.lang.Long">
        select
            count(1)
        from
            browse
        where
            post_id = #{contentId}
            and
            type = #{type}
    </select>
</mapper>