<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudblog.content.mapper.VipMapper">


    <resultMap id="UserVipInfoVoResultMap" type="com.cloudblog.common.pojo.Vo.UserVipInfoVo">
        <result property="userId" column="user_id"/>
        <result property="expiresTime" column="expires_time"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>
    <update id="updateUserVipStatus">
        update user_info set is_vip = #{code} where user_id = #{userId}
    </update>

    <select id="getUserVipInfo" resultType="com.cloudblog.common.pojo.Vo.UserVipInfoVo" resultMap="UserVipInfoVoResultMap">
        select
            user_id,
            expires_time,
            status,
            create_time
        from
            user_vip
        where
            user_id = #{userId} and status = 0
    </select>

    <select id="getOutOfDateVipRecord" resultType="java.lang.Long">
        select
            user_id
        from
            user_vip
        where
            expires_time &lt; now()
        and
            status = 0
    </select>

    <update id="refreshVipRecord">
        update
            user_vip
        set
            status = 1,
            update_time = now()
        where
            expires_time &lt; now()
    </update>

    <update id="refreshUserVipStatus">
        UPDATE user_info
        SET is_vip = 0,
            update_time = NOW()
        WHERE user_id IN
        <foreach collection="oodUsers" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
        AND NOT EXISTS (
            SELECT 1
            FROM user_vip
            WHERE user_vip.user_id = user_info.user_id
            AND expires_time &gt; NOW()
            AND status = 0
        )
    </update>

</mapper>