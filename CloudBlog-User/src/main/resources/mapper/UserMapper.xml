<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudblog.user.mapper.UserMapper">

    <select id="queryUserByNumber" resultType="com.cloudblog.common.pojo.DoMain.User">
        select id,
               user_account,
               phone,
               email,
               password,
               status,
               last_login_time,
               permission_id,
               create_time
        from user where user_account = #{number}
    </select>
</mapper>