<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudblog.user.mapper.UserMapper">

    <select id="queryUserByNumber" resultType="com.cloudblog.user.pojo.dto.User">
        select * from user where user_account = #{number}
    </select>
</mapper>